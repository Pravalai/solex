    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "jose": "6.2.15",
    "lucide-react": "1.67.0",
    "next": "16.4.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
